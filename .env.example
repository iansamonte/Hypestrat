# Hyperliquid Credentials
HL_PRIVATE_KEY=your_private_key_here
HL_WALLET_ADDRESS=your_wallet_address_here
HL_MAINNET=true

# Strategy Parameters
INITIAL_CAPITAL=5000.0
MAX_LEVERAGE=10.0
KELLY_FRACTION=0.25
MAX_DRAWDOWN_THRESHOLD=0.20

# Risk Controls
MAX_POSITION_PCT=0.30
MAX_PORTFOLIO_HEAT=0.60
DAILY_LOSS_LIMIT_PCT=0.05
WEEKLY_LOSS_LIMIT_PCT=0.10

# ML Model Settings
LSTM_SEQUENCE_LEN=60
LSTM_RETRAIN_INTERVAL_HOURS=24
XGBOOST_RETRAIN_INTERVAL_HOURS=12

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/hypestrat.log

# Backtesting
BACKTEST_START=2024-01-01
BACKTEST_END=2025-01-01
